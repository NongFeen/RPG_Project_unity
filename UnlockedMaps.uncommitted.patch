@@ -10,6 +10,38 @@ public struct PlayerSaveData : INetworkSerializable,IEquatable<PlayerSaveData>
     public ClassType characterClass;
     public int upgradePoints;
     public BonusStats bonusStats;
+    // Bitmask by (int)MapName. Supports up to 64 maps.
+    public ulong unlockedMapMask;
+
+    public void EnsureDefaultUnlockedMaps()
+    {
+        if (unlockedMapMask != 0)
+            return;
+
+        // Default: first story map is always playable for a new/old save.
+        unlockedMapMask = 1UL << (int)MapName.Story_01;
+    }
+
+    public bool IsMapUnlocked(MapName mapName)
+    {
+        EnsureDefaultUnlockedMaps();
+        int bit = (int)mapName;
+        if (bit < 0 || bit >= 64)
+            return false;
+
+        return (unlockedMapMask & (1UL << bit)) != 0;
+    }
+
+    public void UnlockMap(MapName mapName)
+    {
+        EnsureDefaultUnlockedMaps();
+        int bit = (int)mapName;
+        if (bit < 0 || bit >= 64)
+            return;
+
+        unlockedMapMask |= 1UL << bit;
+    }
+    
     public bool Equals(PlayerSaveData other)
     {
         return characterName == other.characterName
@@ -17,7 +49,8 @@ public bool Equals(PlayerSaveData other)
             && experience == other.experience
             && characterClass == other.characterClass
             && upgradePoints == other.upgradePoints
-            && bonusStats.Equals(other.bonusStats);
+            && bonusStats.Equals(other.bonusStats)
+            && unlockedMapMask == other.unlockedMapMask;
     }
 
 
@@ -30,5 +63,6 @@ public void NetworkSerialize<T>(BufferSerializer<T> serializer)
         serializer.SerializeValue(ref characterClass);
         serializer.SerializeValue(ref upgradePoints);
         serializer.SerializeValue(ref bonusStats);
+        serializer.SerializeValue(ref unlockedMapMask);
     }
 }
