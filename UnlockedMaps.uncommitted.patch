+    private void UnlockMapsFromCompletion(MapName completedMap)
+    {
+        if (selectedSaveProfileData == null)
+            return;
+
+        selectedSaveProfileData.EnsureDefaults();
+        var save = selectedSaveProfileData.playerSaveData;
+
+        // Always unlock the completed map itself.
+        save.UnlockMap(completedMap);
+
+        MapName? next = GetNextMapToUnlock(completedMap);
+        if (next.HasValue)
+            save.UnlockMap(next.Value);
+
+        selectedSaveProfileData.playerSaveData = save;
+    }
+
+    private static MapName? GetNextMapToUnlock(MapName completedMap)
+    {
+        switch (completedMap)
+        {
+            case MapName.Story_01: return MapName.Story_02;
+            case MapName.Story_02: return MapName.Story_03;
+            case MapName.Story_03: return MapName.Story_04;
+            case MapName.Story_04: return MapName.Story_05;
+            case MapName.Story_05: return null;
+
+            case MapName.Dungeon_01: return MapName.Dungeon_02;
+            case MapName.Dungeon_02: return MapName.Dungeon_03;
+            case MapName.Dungeon_03: return MapName.Dungeon_04;
+            case MapName.Dungeon_04: return MapName.Dungeon_05;
+            case MapName.Dungeon_05: return null;
+
+            case MapName.Raid_01: return MapName.Raid_02;
+            case MapName.Raid_02: return MapName.Raid_03;
+            case MapName.Raid_03: return null;
+
+            default: return null;
+        }
+    }
+
+    private MapName GetFirstUnlockedMapOrDefault()
+    {
+        if (selectedSaveProfileData == null)
+            return MapName.Story_01;
+
+        selectedSaveProfileData.EnsureDefaults();
+
+        Array values = Enum.GetValues(typeof(MapName));
+        foreach (var value in values)
+        {
+            MapName map = (MapName)value;
+            if (selectedSaveProfileData.playerSaveData.IsMapUnlocked(map))
+                return map;
+        }
+
+        return MapName.Story_01;
+    }
+
